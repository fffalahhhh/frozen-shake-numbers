# Copy to .env and adjust. docker compose reads it automatically.

# Database
POSTGRES_USER=frozen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frozen

# Public URL of the app (used in password-reset emails)
APP_URL=http://localhost:8080
WEB_PORT=8080

# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# SMTP for password-reset emails. If SMTP_HOST is empty, reset links are
# printed to the api container log instead (fine for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Frozen Shake <no-reply@example.com>

# Production with HTTPS (docker-compose.prod.yml): your domain, and keep
# nginx private so only Caddy is exposed.
# DOMAIN=frozenshake.duckdns.org
# WEB_PORT=127.0.0.1:8080
